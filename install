#!/bin/bash

# ==========================================
#               SDGAMER SCRIPT
# ==========================================

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${GREEN}[SDGAMER]${NC} Starting automatic download and installation..."

cd /var/www/pterodactyl || { echo -e "${RED}[SDGAMER] Error: /var/www/pterodactyl directory not found!${NC}"; exit 1; }

# Download the updated lowercase file from your GitHub
echo -e "${GREEN}[SDGAMER]${NC} Downloading shootingstars.blueprint..."
curl -sSL -o shootingstars.blueprint https://raw.githubusercontent.com/sdgamer8263-sketch/pterodactyl_extention/main/shootingstars.blueprint

if [ -f "shootingstars.blueprint" ]; then
    echo -e "${GREEN}[SDGAMER]${NC} File downloaded successfully! Running Blueprint setup..."
    
    # Install command
    blueprint -install shootingstars
    
    echo -e "${GREEN}[SDGAMER]${NC} shootingstars setup and installation completed successfully!"
else
    echo -e "${RED}[SDGAMER] Error: Failed to download. Make sure you uploaded the file as 'shootingstars.blueprint' to GitHub.${NC}"
    exit 1
fi
